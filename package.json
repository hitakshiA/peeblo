{
  "name": "peeblo",
  "version": "0.0.1",
  "private": true,
  "description": "Open-source AI teammate for Slack, on Pi and Otari",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "test": "node --test --import ./test/setup.ts \"test/**/*.test.ts\"",
    "knip": "knip --no-progress",
    "test:integration": "node --test --import ./test/setup.ts \"test/integration/*.test.ts\"",
    "format": "biome format --write src test console/src",
    "format:check": "biome format src test console/src"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.4.0",
    "@earendil-works/gondolin": "0.14.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@mozilla-ai/pi-otari": "0.6.0",
    "open-bot-avatar": "0.1.2",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "knip": "6.43.0",
    "typescript": "7.0.2"
  }
}
