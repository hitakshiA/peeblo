# Any long random string.
POSTGRES_PASSWORD=
# Token for the private core API (console, scripts). Any long random string.
PEEBLO_ADMIN_TOKEN=
# Seals Slack secrets at rest: openssl rand -base64 32
PEEBLO_SECRET_KEY=
# The public HTTPS origin that points at the ingress (domain, or a tunnel on a Mac).
PEEBLO_PUBLIC_URL=
