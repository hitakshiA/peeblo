# Any long random string.
POSTGRES_PASSWORD=
# Token for the private core API (console, scripts). Any long random string.
PEEBLO_ADMIN_TOKEN=
# Seals Slack secrets at rest: openssl rand -base64 32
PEEBLO_SECRET_KEY=
# The public HTTPS origin that points at the ingress (domain, or a tunnel on a Mac).
PEEBLO_PUBLIC_URL=
# The console password (the console is at http://127.0.0.1:7340/console/).
PEEBLO_CONSOLE_PASSWORD=
# Slack user ids allowed to change Otari settings, comma-separated.
PEEBLO_ADMINS=
# A JSON file with the Slack app configuration token ({access_token, refresh_token, exp}).
PEEBLO_SLACK_CONFIG_FILE=
