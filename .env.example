# Peeblo settings. The first `./peeblo up` fills in the secrets marked (generated) and stops until the
# required ones are set. Everything else has a working default.

# ── Required ────────────────────────────────────────────────────────────────
# An Otari org service key (dashboard → Keys → new service key). Lets Peeblo bill and cap each person.
OTARI_SERVICE_KEY=
# The public HTTPS origin that reaches the ingress port (a domain with TLS, or a tunnel), e.g. https://peeblo.example.com
PEEBLO_PUBLIC_URL=
# A JSON file with your Slack app configuration token: {"access_token": "...", "refresh_token": "...", "exp": 1234567890}
PEEBLO_SLACK_CONFIG_FILE=
# The console's password (the console is at http://127.0.0.1:7340/console/).
PEEBLO_CONSOLE_PASSWORD=
# Slack user ids of the admins (comma-separated): they approve money and Otari changes, and can change any teammate.
PEEBLO_ADMINS=

# ── Generated on first run ──────────────────────────────────────────────────
POSTGRES_PASSWORD=
PEEBLO_ADMIN_TOKEN=
PEEBLO_SECRET_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Otari region: leave empty for the US, or set to eu.
OTARI_REGION=
# The end-user budget tier new people start on (an id from Otari → Budgets). Empty: the first tier.
OTARI_END_USER_BUDGET_ID=
# Guard for text from outside the company: lakera (your Lakera guardrail in Otari), open (an open guard model), or off.
PEEBLO_GUARD=lakera
# The Lakera project whose policy decides what is flagged (from Lakera's dashboard). Empty: the guardrail's own.
PEEBLO_LAKERA_PROJECT=
# A GitHub token for teammates that work in your repositories (scoped per teammate to the repos you give it).
PEEBLO_GITHUB_TOKEN=
# Signing secrets for webhook triggers from a service, one per service: PEEBLO_HOOK_SECRET_STRIPE, _PAGERDUTY, …
PEEBLO_HOOK_SECRET_STRIPE=
# Otari's server-side tools and vision: on by default; agents use them only when they choose to.
PEEBLO_OTARI_CODE=on
PEEBLO_WEB_FETCH=on
PEEBLO_VISION=on

# ── Ports and names (change only to run two copies side by side) ────────────
PEEBLO_PROJECT=peeblo
PEEBLO_DB_PORT=55432
PEEBLO_API_PORT=7340
PEEBLO_INGRESS_PORT=8787
PEEBLO_PROXY_PORT=7341
