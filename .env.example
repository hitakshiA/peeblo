# Peeblo settings. You don't need to edit this file: the first `./peeblo up` fills in the generated secrets,
# and the console's setup (http://127.0.0.1:7340/console/) saves the rest. A value set here wins over the console's.

# ── Set by the console's setup (or here, for scripted installs) ─────────────
# An Otari service key (dashboard → API keys → Create key → Advanced → Service key). Lets Otari bill and cap each person.
OTARI_SERVICE_KEY=
# The public HTTPS origin that reaches the ingress port (a domain with TLS, or a tunnel), e.g. https://peeblo.example.com
PEEBLO_PUBLIC_URL=
# A JSON file with your Slack app configuration token: {"access_token": "...", "refresh_token": "...", "exp": 1234567890}
PEEBLO_SLACK_CONFIG_FILE=
# The console's password (the console is at http://127.0.0.1:7340/console/).
PEEBLO_CONSOLE_PASSWORD=
# Slack user ids of the admins (comma-separated): they approve money and Otari changes, and can change any teammate.
# Empty: whoever adds Peeblo to Slack becomes the first admin.
PEEBLO_ADMINS=

# ── Generated on first run ──────────────────────────────────────────────────
POSTGRES_PASSWORD=
PEEBLO_ADMIN_TOKEN=
PEEBLO_SECRET_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Otari region: leave empty for the US, or set to eu.
OTARI_REGION=
# The end-user budget tier new people start on (an id from Otari → Budgets). Empty: the service key's
# default end-user budget (Connect Otari sets one, $2 a day, when the key has none).
OTARI_END_USER_BUDGET_ID=
# Guard for text from outside the company: lakera (your Lakera guardrail in Otari), open (an open guard model), or off.
PEEBLO_GUARD=lakera
# The Lakera project whose policy decides what is flagged (from Lakera's dashboard). Empty: the guardrail's own.
PEEBLO_LAKERA_PROJECT=
# A GitHub token for teammates that work in your repositories. Every repo teammate gets this token, so use a
# fine-grained token limited to those repos; Peeblo also limits each teammate to the repos you give it.
PEEBLO_GITHUB_TOKEN=
# MCP servers that only read, whatever their tool names say (comma-separated server names). Empty: none.
PEEBLO_READONLY_SERVERS=
# Signing secrets for webhook triggers from a service, one per service: PEEBLO_HOOK_SECRET_STRIPE, _PAGERDUTY, …
PEEBLO_HOOK_SECRET_STRIPE=
# Otari's server-side tools and vision: on by default; agents use them only when they choose to.
PEEBLO_OTARI_CODE=on
PEEBLO_WEB_FETCH=on
PEEBLO_VISION=on
# Keep each model call's prompt and answer on its Otari trace (Otari → Sessions), for debugging: keep, or off.
PEEBLO_TRACE_CONTENT=off
# The most jobs working at once; the rest wait in line and the person is told. A job waiting on a card doesn't
# count. Empty: one per GB of memory above 2 GB. Computers per size: PEEBLO_AWAKE_CAP_SMALL (8), _LARGE (2).
PEEBLO_MAX_RUNNING=
# A workspace anyone can join: off lets only admins' requests change connected tools (everyone can still read).
PEEBLO_MEMBER_WRITES=on
# The most teammates one person who isn't an admin may keep (empty: no limit).
PEEBLO_MEMBER_HIRES=
# The only GitHub repos (owner/repo, comma-separated) any teammate may touch, whatever the GitHub connection's
# token can reach: calls elsewhere are refused and searches are narrowed to these. Empty: no limit.
PEEBLO_GITHUB_REPOS=

# ── Ports and names (change only to run two copies side by side) ────────────
PEEBLO_PROJECT=peeblo
PEEBLO_DB_PORT=55432
PEEBLO_API_PORT=7340
PEEBLO_INGRESS_PORT=8787
PEEBLO_PROXY_PORT=7341
