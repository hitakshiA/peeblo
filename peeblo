#!/usr/bin/env bash
# ./peeblo up | down | status | logs | check | image [small|large] | slack-app | backup | upgrade
# Linux: everything runs in Docker Compose (core needs /dev/kvm for teammate computers).
# macOS: Compose runs Postgres; core runs natively, because Gondolin needs the host's hypervisor.
set -euo pipefail
cd "$(dirname "$0")"
RUN=local/run; mkdir -p "$RUN"

ensure_env() {
  [ -f .env ] || cp .env.example .env
  chmod 600 .env
  local changed=0
  set_if_empty() { if ! grep -q "^$1=." .env; then sed -i.bak "/^$1=/d" .env && rm -f .env.bak && echo "$1=$2" >> .env && changed=1; fi; }
  set_if_empty POSTGRES_PASSWORD "$(openssl rand -hex 24)"
  set_if_empty PEEBLO_ADMIN_TOKEN "$(openssl rand -hex 24)"
  set_if_empty PEEBLO_SECRET_KEY "$(openssl rand -base64 32)"
  [ $changed = 1 ] && echo "peeblo: generated missing secrets in .env"
  # Everything else (the Otari key, the public address, Slack) is set up in the console after `up`.
  return 0
}
load_env() { set -a; . ./.env; set +a; PROJECT="${PEEBLO_PROJECT:-peeblo}"; [ -e /dev/kvm ] && export KVM_GID="$(stat -c %g /dev/kvm 2>/dev/null || echo 994)"; return 0; }
compose() { docker compose -p "$PROJECT" -f compose.yaml "$@"; }
mac_compose() { docker compose -p "$PROJECT" -f compose.yaml -f compose.mac.yaml "$@"; }
native_env() { export DATABASE_URL="postgres://peeblo:${POSTGRES_PASSWORD}@127.0.0.1:${PEEBLO_DB_PORT:-55432}/peeblo" PEEBLO_DATA_DIR="${PEEBLO_DATA_DIR:-$PWD/local/data}"; }
core_pid() { [ -f "$RUN/core.pid" ] && kill -0 "$(cat "$RUN/core.pid")" 2>/dev/null && cat "$RUN/core.pid"; }

case "${1:-up}" in
  up)
    ensure_env; load_env
    if [ "$(uname)" = Darwin ]; then
      # What a fresh Mac needs, checked before anything starts (docs/SETUP.md, "What you need").
      command -v docker >/dev/null && docker info >/dev/null 2>&1 || { echo "peeblo: Docker isn't running (start Docker Desktop or OrbStack)"; exit 1; }
      [ "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" -ge 24 ] || { echo "peeblo: Node 24 is required (brew install node@24 && brew link --overwrite --force node@24); node -v says $(node -v 2>/dev/null || echo nothing)"; exit 1; }
      command -v pnpm >/dev/null || { echo "peeblo: pnpm is required (brew install pnpm)"; exit 1; }
      command -v qemu-system-aarch64 >/dev/null || { echo "peeblo: QEMU is required for teammate computers (brew install qemu)"; exit 1; }
      command -v mke2fs >/dev/null || [ -x /opt/homebrew/opt/e2fsprogs/sbin/mke2fs ] || [ -x /usr/local/opt/e2fsprogs/sbin/mke2fs ] || { echo "peeblo: e2fsprogs is required to build teammate computers (brew install e2fsprogs)"; exit 1; }
      mac_compose up -d --wait db
      [ -d node_modules ] || pnpm install --frozen-lockfile
      # The console (served by core at http://127.0.0.1:7340/console/), built once.
      # Built on first start, and again whenever its sources are newer than the build (after an update).
      if [ ! -f console/dist/index.html ] || [ -n "$(find console/src console/index.html -newer console/dist/index.html 2>/dev/null | head -1)" ]; then (cd console && pnpm install --frozen-lockfile && pnpm build); fi
      native_env
      # The small computer image, built once (a build lands in images/small-<arch>/<build id>/).
      ls "$PEEBLO_DATA_DIR/images/small-$( [ "$(uname -m)" = arm64 ] && echo aarch64 || echo x86_64)"/*/manifest.json >/dev/null 2>&1 || node src/bin.ts image small
      # After an update, a running core is restarted so it runs the new code.
      if pid=$(core_pid) && [ -n "$(find src config skills db -newer "$RUN/core.pid" -type f 2>/dev/null | head -1)" ]; then
        echo "peeblo: code changed since core started; restarting it"; pkill -TERM -P "$pid" 2>/dev/null; kill "$pid" 2>/dev/null; for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done; rm -f "$RUN/core.pid"
      fi
      if pid=$(core_pid); then echo "peeblo: core already running (pid $pid)"; else
        # A small loop restarts core when the console's setup asks it to (exit 75), e.g. after the Otari key is saved.
        nohup sh -c 'while :; do node src/bin.ts daemon; code=$?; [ "$code" -eq 75 ] || exit "$code"; sleep 1; done' >> "$RUN/core.log" 2>&1 & echo $! > "$RUN/core.pid"
        for _ in $(seq 1 30); do curl -fsS "http://127.0.0.1:${PEEBLO_API_PORT:-7340}/healthz" >/dev/null 2>&1 && break; core_pid >/dev/null || break; sleep 1; done
        core_pid >/dev/null || { echo "peeblo: core failed to start; see $RUN/core.log"; tail -20 "$RUN/core.log"; exit 1; }
        echo "peeblo: core running (pid $(cat "$RUN/core.pid")); logs in $RUN/core.log"
      fi
    else
      command -v docker >/dev/null && docker compose version >/dev/null 2>&1 || { echo "peeblo: Docker with Compose v2 is required"; exit 1; }
      [ -e /dev/kvm ] || { echo "peeblo: /dev/kvm is missing; teammate computers need KVM (a bare-metal server, or a VM with nested virtualization)"; exit 1; }
      compose --profile linux build peeblo
      # The small computer image, built once into the data volume.
      compose --profile linux run --rm --no-deps --entrypoint sh peeblo -c 'ls /data/images/small-*/*/manifest.json' >/dev/null 2>&1 || compose --profile linux run --rm peeblo image small
      compose --profile linux up -d --wait
    fi
    echo "peeblo: up. Open the console to set up or look around: http://127.0.0.1:${PEEBLO_API_PORT:-7340}/console/"
    [ "$(uname)" = Darwin ] || echo "        (on a server: ssh -L ${PEEBLO_API_PORT:-7340}:127.0.0.1:${PEEBLO_API_PORT:-7340} <server>, then open that address)" ;;
  down)
    load_env
    if pid=$(core_pid); then pkill -TERM -P "$pid" 2>/dev/null; kill "$pid" 2>/dev/null; for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || pgrep -P "$pid" >/dev/null || break; sleep 0.5; done; rm -f "$RUN/core.pid"; echo "peeblo: core stopped"; fi
    if [ "$(uname)" = Darwin ]; then mac_compose stop db; else compose --profile linux stop; fi ;;
  backup)
    # The database and the data that can't be rebuilt (memory, settings, workspaces); computer images are rebuilt.
    load_env; mkdir -p local/backups; at="$(date -u +%Y%m%d-%H%M%S)"; out="local/backups/peeblo-$at"
    compose exec -T db pg_dump -U peeblo -d peeblo --format=custom > "$out.dump" || { echo "peeblo: the database dump failed (is it running? ./peeblo up)"; exit 1; }
    if [ "$(uname)" = Darwin ]; then native_env; tar -czf "$out-data.tgz" -C "$PEEBLO_DATA_DIR" --exclude ./images .
    else docker run --rm -v "${PROJECT}_data:/data:ro" -v "$PWD/local/backups:/out" alpine:3.20 tar -czf "/out/peeblo-$at-data.tgz" -C /data --exclude ./images .; fi
    echo "peeblo: backed up to $out.dump and $out-data.tgz (restore: pg_restore --clean into the db, untar into the data directory)" ;;
  upgrade)
    # Never mid-job: an approval or a running job would be cut. Then the new code, and a restart.
    load_env
    busy=$(compose exec -T db psql -U peeblo -d peeblo -Atc "SELECT count(*) FROM runs WHERE status IN ('running','waiting')" 2>/dev/null || echo 0)
    if [ "${busy:-0}" -gt 0 ] && [ "${2:-}" != "--now" ]; then echo "peeblo: $busy job(s) are running or waiting on an approval; try again later, or ./peeblo upgrade --now"; exit 1; fi
    git pull --ff-only || { echo "peeblo: git pull failed; nothing changed"; exit 1; }
    "$0" down && "$0" up ;;
  status)
    load_env
    if [ "$(uname)" = Darwin ]; then mac_compose ps; pid=$(core_pid) && echo "core: running (pid $pid)" || echo "core: stopped"; else compose --profile linux ps; fi ;;
  logs) if [ "$(uname)" = Darwin ]; then tail -f "$RUN/core.log"; else load_env; compose logs -f peeblo; fi ;;
  check|image|slack-app|rotate-key)
    load_env
    if [ "$(uname)" = Darwin ]; then native_env; node src/bin.ts "$@"
    # The large image is built from a Debian container image, with the host's Docker, for this command only.
    elif [ "${1:-}" = image ] && [ "${2:-}" = large ]; then compose --profile linux run --rm --no-deps --user "1000:$(stat -c %g /var/run/docker.sock)" -v /var/run/docker.sock:/var/run/docker.sock peeblo "$@"
    else compose --profile linux run --rm peeblo "$@"; fi ;;
  *) echo "usage: ./peeblo up|down|status|logs|check|image|slack-app|rotate-key|backup|upgrade"; exit 2 ;;
esac
